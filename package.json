  "main": "dist-electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
